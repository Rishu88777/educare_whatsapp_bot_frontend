# Copy to .env.local and adjust before `npm run dev` / `npm run build`.

# Base URL of the Educare bot service REST API.
VITE_API_BASE_URL=http://localhost:9082/api/educare

# WhatsApp number (country code, no +) used for the floating "Chat with us on
# WhatsApp" button. Leave blank to hide the button entirely.
VITE_WA_NUMBER=
